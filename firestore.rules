rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The Java server uses Firebase Admin credentials and bypasses these rules.
    // Clients can read their own account only; all writes go through the server.
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.admin == true);
      allow write: if false;
      match /transactions/{id} {
        allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.admin == true);
        allow write: if false;
      }
      match /games/{id} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
